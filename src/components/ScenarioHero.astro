---
import { nav, pillars, milestones } from '../data/site';

// Coordenadas no quadro do comp aprovado (2752 × 1536).
const W = 2752;
const H = 1536;
const TODAY = 2026.87; // novembro de 2026
const NOW_X = 1428;
const yearX = (y: number) => NOW_X + ((2508 - NOW_X) / (2035 - TODAY)) * (y - TODAY);
const origin = { x: NOW_X, y: 883 };
const end = { x: yearX(2035), y: 705 };
const years = Array.from({ length: 11 }, (_, i) => 2025 + i);
const axisYears = years.filter((y) => Math.abs(yearX(y) - 1428) > 40);

// Linha do passado (série observada, desenho conceitual) até a origem.
const pastRaw: [number, number][] = [
  [237, 995], [358, 982], [466, 986], [591, 968], [717, 941], [788, 953],
  [878, 928], [968, 935], [1075, 896], [1183, 878], [1236, 905], [1272, 905], [1326, 883],
];
const pastPts: [number, number][] = pastRaw.map(([x, y]) => [237 + ((x - 237) * (origin.x - 237)) / (1326 - 237), y]);
const pastYAt = (x: number) => {
  for (let i = 0; i < pastPts.length - 1; i++) {
    const [x0, y0] = pastPts[i];
    const [x1, y1] = pastPts[i + 1];
    if (x >= x0 && x <= x1) return y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
  }
  return origin.y;
};
const smooth = (pts: [number, number][]) => {
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0]},${p2[1]}`;
  }
  return d;
};
const pastPath = smooth(pastPts);

// Faixas de cenário: abrem a partir da origem até 2035 (ilustração conceitual de incerteza, sem valores).
const L = end.x - origin.x;
const ease = (t: number) => Math.pow(t, 1.15);
const centerY = (t: number) => origin.y + (end.y - origin.y) * ease(t);
// Bordas em lóbulo: a faixa superior incha e assenta; a inferior se abre e afina no fim.
const upper = (endY: number) => (t: number) => {
  const swell = 1 - Math.pow(1 - t, 1.7);
  return origin.y + (endY - origin.y) * (swell * 0.92 + 0.08 * t);
};
const lower = (endY: number, taper: number) => (t: number) => {
  const open = 1 - Math.pow(1 - t, 1.9);
  return origin.y + (endY - origin.y) * open * (1 - taper * Math.pow(t, 3));
};
const bandPath = (top: number, bottom: number, taper: number) => {
  const n = 64;
  const up: string[] = [];
  const down: string[] = [];
  for (let i = 0; i <= n; i++) {
    const t = i / n;
    const x = origin.x + L * t;
    up.push(`${x.toFixed(1)},${upper(top)(t).toFixed(1)}`);
    down.unshift(`${x.toFixed(1)},${lower(bottom, taper)(t).toFixed(1)}`);
  }
  return `M${up.join(' L')} L${down.join(' L')} Z`;
};
const bands = [
  { d: bandPath(360, 1135, 0.0), fill: 'var(--band-4)', o: 0.9 },
  { d: bandPath(470, 1030, 0.06), fill: 'var(--band-3)', o: 0.85 },
  { d: bandPath(545, 930, 0.1), fill: 'var(--band-2)', o: 0.82 },
  { d: bandPath(610, 840, 0.14), fill: 'var(--band-1)', o: 0.85 },
  { d: bandPath(660, 770, 0.18), fill: 'var(--band-core)', o: 0.9 },
];
const trendPath = `M${pastPts[0][0]},${pastPts[0][1] + 6} L${origin.x},${origin.y - 4}`;
const centerPath = (() => {
  const pts: string[] = [];
  for (let i = 0; i <= 40; i++) {
    const t = i / 40;
    pts.push(`${(origin.x + L * t).toFixed(1)},${centerY(t).toFixed(1)}`);
  }
  return `M${pts.join(' L')}`;
})();
const tFor = (x: number) => Math.min(1, Math.max(0, (x - origin.x) / L));

// Caixas de rótulo dos marcos (do comp) e posição real no eixo.
const labelBoxes = [
  { x: 1146, y: 760, w: 200, h: 92, align: 'center' },
  { x: 1745, y: 686, w: 250, h: 92, align: 'center' },
  { x: 2008, y: 600, w: 500, h: 60, align: 'end' },
];
const marks = milestones.map((m, i) => {
  const x = yearX(m.year);
  const y = x <= origin.x ? pastYAt(x) : centerY(tFor(x));
  const box = labelBoxes[i];
  return { ...m, x, y, box, anchorX: box.align === 'end' ? box.x + box.w : box.x + box.w / 2 };
});
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

const chartBody = [
  `<g class="q-grid" stroke="var(--grid)" stroke-width="2">${axisYears.map((y) => `<line x1="${yearX(y)}" x2="${yearX(y)}" y1="300" y2="1178"/>`).join('')}</g>`,
  `<path class="q-trend" d="${trendPath}" fill="none" stroke="var(--ink)" stroke-opacity="0.3" stroke-width="2" stroke-dasharray="2 10"/>`,
  `<g class="q-bands">${bands.map((b) => `<path d="${b.d}" fill="${b.fill}" fill-opacity="${b.o}"/>`).join('')}</g>`,
  `<path class="q-center" d="${centerPath}" fill="none" stroke="var(--ink)" stroke-opacity="0.35" stroke-width="2" stroke-dasharray="2 12"/>`,
  `<path class="q-past" d="${pastPath}" fill="none" stroke="var(--ink)" stroke-width="3.2" stroke-linecap="round" pathLength="1"/>`,
  `<line class="q-now" x1="1428" x2="1428" y1="300" y2="1178" stroke="var(--violet)" stroke-width="4"/>`,
].join('');
const marksDesktop = marks
  .map((m) => `<g class="q-mark"><line x1="${m.x}" y1="${m.y}" x2="${m.x}" y2="1178" stroke="var(--ink)" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="3 8"/>${m.box.align === 'end' ? '' : `<line x1="${m.anchorX}" y1="${m.box.y + m.box.h - 22}" x2="${m.x}" y2="${m.y}" stroke="var(--ink)" stroke-opacity="0.28" stroke-width="1.5"/>`}<circle cx="${m.x}" cy="${m.y}" r="9" fill="var(--ground-raised)" stroke="var(--ink)" stroke-width="3.5"/></g>`)
  .join('');
const marksMobile = marks
  .map((m) => `<g class="q-mark"><circle cx="${m.x}" cy="${m.y}" r="13" fill="var(--ground-raised)" stroke="var(--ink)" stroke-width="5"/><text x="${m.x + (m.ref === 'Q-02' ? 22 : -20)}" y="${m.y - (m.ref === 'Q-01' ? 48 : 26)}" font-size="40" text-anchor="${m.ref === 'Q-02' ? 'start' : 'end'}" fill="var(--ink)">${m.ref}</text></g>`)
  .join('');
const mobileText = `<g font-size="44" fill="var(--ink)">${[2030, 2035].map((y) => `<text x="${yearX(y)}" y="1240" text-anchor="middle">${y}</text>`).join('')}<text x="${NOW_X}" y="1240" text-anchor="middle" fill="var(--violet)">nov 2026</text><text x="${NOW_X + 18}" y="290" fill="var(--violet)">HOJE</text></g>`;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="frame">
    <svg class="chart" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" set:html={chartBody + marksDesktop} />

    <header class="masthead">
      <a class="brand" href="/" aria-label="QUASAR — página inicial">
        <img class="mark-img" src="/brand/quasar-mark.png" alt="" width="78" height="78" />
        <span class="wordmark">QUASAR</span>
      </a>
      <nav class="nav" aria-label="Principal">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </header>

    <div class="lede" id="conteudo">
      <h1 id="hero-title" class="headline">
        <span>O futuro não é apenas</span> <span>sobre tecnologia.</span> <span>É sobre antecipação.</span>
      </h1>
      <p class="signature"><span>Transformamos Ciência em Estratégia</span><span class="signature-rule" aria-hidden="true"></span></p>
      <a class="explore" href="#pilares">Explorar os pilares<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></a>
    </div>
    <svg class="chart-m" viewBox="1150 250 1450 1030" aria-hidden="true" set:html={chartBody + marksMobile + mobileText} />

    <p class="sr-only">
      Ilustração conceitual de cenários: a partir de hoje (2026), o futuro se abre em faixas de incerteza até 2035,
      com marcos regulatórios e científicos datados.
    </p>
    <span class="chart-label now-label" aria-hidden="true">HOJE</span>
    <span class="chart-label end-label" aria-hidden="true">2035</span>

    <ol class="marks" aria-label="Marcos no horizonte">
      {marks.map((m) => (
        <li
          class="mark-note"
          data-align={m.box.align}
          style={`left:${pct(m.box.x, W)};top:${pct(m.box.y, H)};width:${pct(m.box.w, W)};`}
        >
          <a href={`#marco-${m.ref.toLowerCase()}`} id={`hero-${m.ref.toLowerCase()}`}>
            <span class="chip">{m.label}</span>
            <span class="ref">[{m.ref}]</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="axis" aria-hidden="true">
      {axisYears.map((y) => (
        <span class="tick" style={`left:${pct(yearX(y), W)}`}>{y}</span>
      ))}
      <span class="tick today" style={`left:${pct(1428, W)}`}>nov 2026</span>
    </div>

    <ol class="pillars" aria-label="Pilares de atuação">
      {pillars.map((p, i) => (
        <li class="pillar" style={`left:${pct(230 + i * 398, W)}; --tone:${p.tone}`}>
          <a href={`#pilar-${p.num}`}>
            <span class="num">{p.num}</span>
            <span class="title"><span>{p.title[0]}</span> <span>{p.title[1]}</span></span>
          </a>
        </li>
      ))}
    </ol>

    <p class="source">Fonte: NIST IR 8547; Banco Central do Brasil</p>
  </div>
</section>

<style>
  .hero { background: var(--ground); }

  .frame {
    position: relative;
    width: 100%;
    aspect-ratio: 2752 / 1536;
    container-type: inline-size;
    overflow: hidden;
  }

  .chart { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* Masthead */
  .masthead { position: absolute; inset: 0 0 auto 0; height: 12%; }
  .brand { position: absolute; left: 8.28%; top: 0; height: 100%; display: block; text-decoration: none; }
  .mark-img { position: absolute; left: 0; top: 1.892cqw; width: 2.834cqw; height: 2.834cqw; }
  .wordmark {
    position: absolute;
    left: 3.06cqw;
    top: 2.35cqw;
    font-size: 1.66cqw;
    font-weight: 500;
    letter-spacing: 0.035em;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
  }
  .nav { position: absolute; left: 56.54%; width: 35.25%; top: 2.42cqw; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; justify-content: space-between; }
  .nav a {
    font-size: 1.24cqw;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.3em;
    background: linear-gradient(var(--violet), var(--violet)) left bottom / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease-out);
  }
  .nav a:hover { background-size: 100% 1px; }

  /* Lede */
  .lede { position: absolute; left: 8.5%; top: 19.99%; width: 41%; }
  .headline {
    margin: 0;
    font-size: 4.43cqw;
    font-weight: 500;
    line-height: 0.985;
    letter-spacing: -0.038em;
    color: var(--ink);
  }
  .headline span { display: block; white-space: nowrap; }
  .signature {
    margin: 0;
    position: absolute;
    left: -0.07cqw;
    top: 13.6cqw;
    width: 39.9cqw;
    display: flex;
    align-items: center;
    gap: 1.25cqw;
    font-size: 1.71cqw;
    font-weight: 400;
    letter-spacing: -0.005em;
    color: var(--ink);
    white-space: nowrap;
  }
  .signature-rule { flex: 1; height: 1px; background: var(--rule-strong); }
  .explore {
    position: absolute;
    left: 0;
    top: 17.2cqw;
    display: inline-flex;
    align-items: center;
    gap: 0.4cqw;
    font-size: 0.95cqw;
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
  }
  .explore svg { width: 0.9cqw; height: 0.9cqw; }
  .explore:hover { color: var(--ink); text-decoration-color: var(--violet); }

  .chart-label { position: absolute; top: 19.75%; font-size: 0.92cqw; line-height: 1; letter-spacing: -0.01em; }
  .now-label { left: 52.35%; color: var(--violet); font-weight: 400; }
  .end-label { left: 88.74%; color: var(--ink); }

  /* Marcos */
  .marks { list-style: none; margin: 0; padding: 0; }
  .mark-note { position: absolute; display: flex; justify-content: center; }
  .mark-note[data-align='end'] { justify-content: flex-end; }
  .mark-note a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45cqw;
    text-decoration: none;
    color: var(--ink);
  }
  .mark-note[data-align='end'] a { flex-direction: row; align-items: center; gap: 0.5cqw; }
  .chip {
    font-size: max(0.9cqw, 0.8125rem);
    line-height: 1;
    padding: 0.38cqw 0.45cqw;
    background: var(--ground-raised);
    border-radius: 2px;
    box-shadow: 0 0.06cqw 0.3cqw rgb(10 26 54 / 0.12);
    white-space: nowrap;
    transition: box-shadow 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .ref { font-size: max(0.78cqw, 0.75rem); line-height: 1; color: var(--ink); white-space: nowrap; }
  .mark-note a:hover .chip,
  .mark-note a:focus-visible .chip { box-shadow: 0 0.12cqw 0.6cqw rgb(10 26 54 / 0.18); transform: translateY(-0.1cqw); }

  /* Eixo */
  .axis { position: absolute; inset: 0; pointer-events: none; }
  .tick.today { color: var(--violet); }
  .tick {
    position: absolute;
    top: 77.6%;
    transform: translateX(-50%);
    font-size: 0.9cqw;
    line-height: 1;
    color: var(--ink);
  }

  /* Régua de pilares */
  .pillars { list-style: none; margin: 0; padding: 0; }
  .pillar { position: absolute; top: 82.95%; width: 13.9%; }
  .pillar + .pillar::before {
    content: '';
    position: absolute;
    left: -1.06cqw;
    top: 0.9cqw;
    height: 5.1cqw;
    width: 1px;
    background: var(--rule);
  }
  .pillar a {
    display: block;
    position: relative;
    padding-top: 1.05cqw;
    text-decoration: none;
    color: var(--ink);
    background: linear-gradient(var(--rule), var(--rule)) left 0.08cqw / 78% 1px no-repeat;
  }
  .pillar a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 78%;
    height: 0.22cqw;
    background: var(--tone);
    clip-path: inset(0 calc(100% - 1.45cqw) 0 0);
    transition: clip-path 0.6s var(--ease-out);
  }
  .pillar a::after {
    content: '';
    position: absolute;
    left: calc(78% - 1.2cqw);
    top: 2.35cqw;
    width: 1.2cqw;
    height: 1px;
    background: var(--tone);
    opacity: 0.75;
  }
  .pillar a:hover::before,
  .pillar a:focus-visible::before { clip-path: inset(0 0 0 0); }
  .num { display: block; font-size: 1.32cqw; line-height: 1; margin-bottom: 0.55cqw; }
  .title { display: block; font-size: 1.76cqw; line-height: 1.08; letter-spacing: -0.01em; }
  .title span { display: block; }

  .source {
    position: absolute;
    right: 8.37%;
    top: 96.3%;
    margin: 0;
    font-size: max(0.82cqw, 0.75rem);
    font-weight: 400;
    letter-spacing: -0.012em;
    line-height: 1;
    color: var(--ink);
  }

  .chart-m { display: none; }

  /* Movimento: o futuro se abre a partir de hoje (uma vez, no carregamento). */
  .hero :global(.q-bands) { animation: q-open 1.9s var(--ease-out) 0.45s both; }
  .hero :global(.q-center) { animation: q-fade 1.2s var(--ease-out) 1.3s both; }
  .hero :global(.q-past) { stroke-dasharray: 1; animation: q-draw 1.1s var(--ease-out) 0s both; }
  .hero :global(.q-mark),
  .mark-note { animation: q-fade 0.9s var(--ease-out) both; }
  .hero :global(.q-mark:nth-of-type(1)), .mark-note:nth-child(1) { animation-delay: 1.15s; }
  .hero :global(.q-mark:nth-of-type(2)), .mark-note:nth-child(2) { animation-delay: 1.5s; }
  .hero :global(.q-mark:nth-of-type(3)), .mark-note:nth-child(3) { animation-delay: 1.85s; }
  @keyframes q-open { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes q-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes q-fade { from { opacity: 0; } to { opacity: 1; } }

  @media (max-width: 900px) {
    .frame {
      aspect-ratio: auto;
      container-type: normal;
      overflow: visible;
      display: flex;
      flex-direction: column;
      padding: 1.25rem 1.25rem 3rem;
    }
    .chart, .chart-label, .axis { display: none; }
    .masthead { position: static; height: auto; display: flex; flex-direction: column; gap: 1rem; }
    .brand { position: static; display: inline-flex; align-items: center; gap: 0.55rem; height: auto; }
    .mark-img { position: static; width: 2.25rem; height: 2.25rem; }
    .wordmark { position: static; font-size: 1.0625rem; }
    .nav { position: static; width: auto; }
    .nav ul { flex-wrap: wrap; justify-content: flex-start; gap: 0.35rem 1.25rem; }
    .nav a { font-size: 1.0625rem; }
    .lede { position: static; width: auto; margin-top: 3rem; }
    .headline { font-size: clamp(2.4rem, 4.4vw, 4.8rem); line-height: 1.04; letter-spacing: -0.032em; }
    .headline span { display: inline; white-space: normal; }
    .signature { position: static; width: auto; margin-top: 1.25rem; font-size: clamp(1.05rem, 1.15vw, 1.25rem); white-space: normal; }
    .signature-rule { display: none; }
    .explore { position: static; margin-top: 1rem; font-size: 1.0625rem; gap: 0.4rem; }
    .explore svg { width: 0.9rem; height: 0.9rem; }
    .chart-m { display: block; width: 100%; height: auto; margin-top: 2.25rem; }
    .marks { display: grid; gap: 0.6rem; margin-top: 1rem; }
    .mark-note { position: static; width: auto !important; justify-content: flex-start !important; }
    .mark-note a, .mark-note[data-align='end'] a { flex-direction: row-reverse; align-items: baseline !important; gap: 0.6rem; }
    .chip { font-size: 0.8125rem; padding: 0.3rem 0.45rem; border-radius: 2px; box-shadow: 0 1px 4px rgb(10 26 54 / 0.12); white-space: normal; }
    .ref { font-size: 0.8125rem; }
    .pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 1.75rem 1.25rem; margin-top: 2.75rem; }
    .pillar { position: static; width: auto !important; }
    .pillar + .pillar::before { display: none; }
    .pillar a { padding-top: 0.9rem; background-size: 100% 1px; }
    .pillar a::before { width: 100%; height: 3px; top: -1px; clip-path: inset(0 calc(100% - 2rem) 0 0); }
    .pillar a::after { display: none; }
    .num { font-size: 0.8125rem; margin-bottom: 0.4rem; }
    .title { font-size: 1.0625rem; }
    .source { position: static; margin-top: 2rem; font-size: 0.8125rem; }
  }
</style>
