---
// Ícones Lucide (lucide-static), embutidos como SVG inline.
interface Props { name: string; size?: number; stroke?: number; class?: string; label?: string }
const { name, size = 20, stroke = 1.75, class: cls = '', label } = Astro.props;

const files = import.meta.glob(
  '/node_modules/lucide-static/icons/{activity,arrow-left,arrow-right,arrow-up-right,atom,award,badge-check,book-open,bot,brain-circuit,briefcase,building-2,calendar,calendar-check,chart-no-axes-column,check,chevron-down,chevron-left,chevron-right,circle-alert,circle-check,circle-help,clock,compass,cpu,database,eye,file-search,file-text,fingerprint,gauge,globe,handshake,hard-drive,info,key-round,landmark,layers,life-buoy,link,list-checks,lock,lock-keyhole,mail,map-pin,menu,message-square,microscope,network,newspaper,orbit,phone,presentation,quote,radar,radio-tower,route,scale,scan-eye,search,send,shield-alert,shield-check,sparkles,target,timer,trending-up,triangle-alert,user-check,mail-check,file-check,clipboard-check,list-checks,hourglass,user-round,users,workflow,x,zap}.svg',
  { query: '?raw', import: 'default', eager: true },
) as Record<string, string>;

const brands: Record<string, string> = {
  linkedin: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>',
  instagram: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r="1" fill="currentColor" stroke="none"/></svg>',
};

let svg = brands[name] ?? files[`/node_modules/lucide-static/icons/${name}.svg`];
if (!svg) throw new Error(`Ícone inexistente: ${name}`);
svg = svg
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/<svg[^>]*>/, (tag) => tag.replace(/\s(width|height|class)="[^"]*"/g, ''))
  .replace(/stroke-width="[^"]*"/, `stroke-width="${stroke}"`)
  .replace('<svg', `<svg width="${size}" height="${size}" class="${cls}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} focusable="false"`);
---
<Fragment set:html={svg} />
