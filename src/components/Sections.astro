---
import { pillars, pillarOffers, pillarImages, agenda, context, approach, sectors, perspectives, nav } from '../data/site';

const statusClass: Record<string, string> = { 'Em vigor': 'is-live', 'Em tramitação': 'is-pending', Previsto: 'is-ahead' };
const pos: Record<string, number> = { 'Q-04': 2025.83, 'Q-01': 2026.17, 'Q-05': 2026.85, 'Q-06': 2026.85, 'Q-07': 2027.5, 'Q-02': 2030, 'Q-03': 2035 };
const lane: Record<string, number> = { 'Q-04': 1, 'Q-05': 1, 'Q-06': 2 };
// Separação mínima no celular para marcos coincidentes (só deslocamento visual, a data não muda).
const nudge: Record<string, string> = { 'Q-04': '-6px', 'Q-01': '6px', 'Q-05': '-8px', 'Q-06': '8px' };
const xOf = (y: number) => ((y - 2025) / 10) * 100;
const axisYears = Array.from({ length: 11 }, (_, i) => 2025 + i);
const arrow = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>';
---
<!-- Contexto: números com fonte (padrão Palo Alto / Bain) -->
<section id="contexto" class="sec dark context" aria-labelledby="contexto-title">
  <div class="wrap ctx-grid">
    <div>
      <h2 id="contexto-title">O risco mudou de velocidade.</h2>
      <p class="lead">A IA acelera ataques, fraudes e decisões automatizadas. A computação quântica coloca prazo na criptografia de hoje. A estratégia precisa chegar antes.</p>
    </div>
    <ul class="stats">
      {context.map((c) => (
        <li>
          <span class="stat-fig">{c.figure}<span class="stat-unit" aria-hidden={'unit' in c && c.unit ? undefined : 'true'}>{'unit' in c && c.unit ? c.unit : '\u00a0'}</span></span>
          <p>{c.text}</p>
          <span class="src">Fonte: {c.source}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Pilares: cards com imagem e título sobreposto (padrão BCG / EY) -->
<section id="pilares" class="sec light" aria-labelledby="pilares-title">
  <div class="wrap">
    <div class="head">
      <h2 id="pilares-title">Seis pilares. Uma visão de risco.</h2>
      <p class="lead">Tecnologia, segurança, regulação e ciência não chegam ao Conselho separadas. A QUASAR trabalha os seis temas como um só sistema.</p>
    </div>
    <ul class="pillar-grid">
      {pillars.map((p) => (
        <li id={`pilar-${p.num}`} class="pcard">
          <img src={pillarImages[p.num]} alt="" width="900" height="1200" loading="lazy" decoding="async" />
          <div class="pcard-body">
            <h3>{p.name}</h3>
            <p>{p.summary}</p>
            <ul class="pcard-offers">
              {pillarOffers[p.num].map((o) => <li>{o}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Agenda do Conselho -->
<section id="agenda" class="sec dark" aria-labelledby="agenda-title">
  <div class="wrap">
    <div class="head">
      <h2 id="agenda-title">Agenda do Conselho</h2>
      <p class="lead">Os marcos regulatórios e científicos que já estão no horizonte, em ordem de chegada. Cada linha tem endereço próprio para ir direto à pauta da próxima reunião.</p>
    </div>
    <div class="horizon" aria-hidden="true">
      <span class="h-today" style={`left:${xOf(2026.85)}%`}><span>HOJE</span></span>
      {agenda.map((r) => (
        <a class:list={['h-dot', statusClass[r.status], { 'lane-up': (lane[r.ref] ?? 0) > 0, 'label-left': r.ref === 'Q-04' }]} href={`#marco-${r.ref.toLowerCase()}`} tabindex="-1" style={`left:${xOf(pos[r.ref])}%; --lane:${lane[r.ref] ?? 0}; --mx:${nudge[r.ref] ?? '0px'}`}><span>{r.ref}</span></a>
      ))}
      <div class="h-axis">{axisYears.map((y) => <span style={`left:${xOf(y)}%`}>{y}</span>)}</div>
    </div>
    <div class="table-scroll">
      <table class="agenda">
        <caption class="sr-only">Marcos regulatórios e científicos, por data, com situação e fonte</caption>
        <thead><tr><th scope="col">Quando</th><th scope="col">Marco</th><th scope="col">O que muda</th><th scope="col">Situação</th><th scope="col">Fonte</th></tr></thead>
        <tbody>
          {agenda.map((r) => (
            <tr id={`marco-${r.ref.toLowerCase()}`}>
              <td class="when">{r.when}</td>
              <th scope="row" class="item"><a href={`#marco-${r.ref.toLowerCase()}`}>{r.item}</a><span class="ref">[{r.ref}]</span></th>
              <td class="detail">{r.detail}</td>
              <td><span class:list={['status', statusClass[r.status]]}>{r.status}</span></td>
              <td class="src-cell">{r.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">Situação verificada em novembro de 2026. Conferir a fonte primária antes de decisões formais.</p>
  </div>
</section>

<!-- Abordagem -->
<section id="abordagem" class="sec light" aria-labelledby="abordagem-title">
  <div class="wrap">
    <div class="head">
      <h2 id="abordagem-title">Do diagnóstico à escala.</h2>
      <p class="lead">Pensamos em risco, atuamos com estratégia e entregamos com clareza. Toda conversa começa pelo que está exposto, nunca pela ferramenta.</p>
    </div>
    <ol class="steps">
      {approach.map((a, i) => (
        <li>
          <span class="step-marker" aria-hidden="true"></span><span class="step-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{a.step}</h3>
          <p>{a.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Perspectivas: cards editoriais (padrão Bain / McKinsey) -->
<section id="perspectivas" class="sec paper" aria-labelledby="perspectivas-title">
  <div class="wrap">
    <div class="head">
      <h2 id="perspectivas-title">Perspectivas para o Conselho</h2>
      <p class="lead">O que a liderança precisa decidir agora sobre IA, computação quântica e governança.</p>
    </div>
    <ul class="insights">
      {perspectives.map((p) => (
        <li class="icard">
          <a href={p.href}>
            <span class="icard-img"><img src={p.image} alt="" width="1000" height="667" loading="lazy" decoding="async" /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <span class="icard-more">Ler perspectiva <Fragment set:html={arrow} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Setores: blocos com borda (padrão EY) -->
<section id="setores" class="sec dark" aria-labelledby="setores-title">
  <div class="wrap sector-grid">
    <div>
      <h2 id="setores-title">Onde o risco tecnológico é estratégico.</h2>
      <p class="lead">Atuamos onde uma falha tecnológica vira problema de Conselho: continuidade, regulação, reputação e capital.</p>
    </div>
    <ul class="sectors">
      {sectors.map((s) => (
        <li>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Liderança -->
<section id="lideranca" class="sec leader" aria-labelledby="lideranca-title">
  <div class="wrap leader-grid">
    <div class="leader-copy">
      <h2 id="lideranca-title">Jorge Muzy</h2>
      <p class="role">Fundador e Chief AI Officer</p>
      <p>Mais de quarenta anos de carreira corporativa como CEO e em posições C-level em empresas como Icon Aviation, EMS, Amil e Ibmec. Na última década, dedicado à aplicação corporativa e à governança da inteligência artificial.</p>
      <p>Chairman do Instituto Valor, fundador e CEO da AINEWS e idealizador do AI Summit Brasil. Autor de um livro sobre inteligência artificial, <cite>Além dos Algoritmos</cite>, e de centenas de publicações sobre tecnologia, inovação e IA.</p>
      <blockquote><p>“Na QUASAR, cada projeto é uma experiência científica com propósito estratégico. Nossa entrega é conhecimento aplicado, e nossa métrica é o impacto real.”</p></blockquote>
    </div>
    <figure class="leader-photo">
      <img src="/team/jorge-muzy.png" alt="Jorge Muzy, fundador da QUASAR" width="409" height="613" loading="lazy" decoding="async" />
    </figure>
  </div>
</section>

<!-- Ecossistema -->
<section id="ecossistema" class="eco" aria-labelledby="eco-title">
  <div class="wrap eco-grid">
    <h2 id="eco-title" class="eco-title">Patrocinadora oficial do AI Summit Brasil 2026</h2>
    <a class="eco-logo" href="https://aisummit.ia.br/" rel="noopener" aria-label="AI Summit Brasil 2026">
      <img src="/brand/ai-summit-2026.png" alt="AI Summit Brasil 2026" width="200" height="58" />
    </a>
    <ul class="eco-list">
      <li><strong>Instituto Valor</strong><span>Chairman: Jorge Muzy</span></li>
      <li><strong>AINEWS</strong><span>Fundador e CEO: Jorge Muzy</span></li>
      <li><strong>AI Summit Brasil</strong><span>O maior evento de IA da América Latina</span></li>
    </ul>
  </div>
</section>

<!-- Contato sobre imagem -->
<section id="contato" class="cta-band" aria-labelledby="contato-title">
  <img class="cta-bg" src="/images/cta-skyline.webp" alt="" width="2200" height="943" loading="lazy" decoding="async" />
  <div class="wrap cta-inner">
    <h2 id="contato-title">Vamos conversar sobre o futuro da sua empresa.</h2>
    <p class="lead">Uma conversa estratégica com a liderança da QUASAR para entender o que está exposto e o que vem pela frente.</p>
    <div class="cta-actions">
      <a class="pill pill-solid big" href="mailto:muzy@quasar.ia.br?subject=Conversa%20estrat%C3%A9gica%20com%20a%20QUASAR">Agendar uma conversa</a>
      <a class="pill pill-ghost big" href="https://chat.whatsapp.com/HCzXAB70XIqBTvUaakYoxt" rel="noopener">Entrar no grupo de WhatsApp</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a href="/" class="fb-logo" aria-label="QUASAR — página inicial"><img src="/brand/quasar-mark.png" alt="" width="40" height="40" /><span>QUASAR</span></a>
      <p>Transformamos Ciência em Estratégia.</p>
    </div>
    <nav class="foot-col" aria-label="Pilares">
      <h3>Pilares</h3>
      <ul>{pillars.map((p) => <li><a href={`#pilar-${p.num}`}>{p.name}</a></li>)}</ul>
    </nav>
    <nav class="foot-col" aria-label="Empresa">
      <h3>Empresa</h3>
      <ul>
        <li><a href="#abordagem">Abordagem</a></li>
        <li><a href="#setores">Setores</a></li>
        <li><a href="#perspectivas">Perspectivas</a></li>
        <li><a href="#agenda">Agenda do Conselho</a></li>
        <li><a href="#lideranca">Liderança</a></li>
      </ul>
    </nav>
    <div class="foot-col">
      <h3>Contato</h3>
      <ul>
        <li><a href="mailto:muzy@quasar.ia.br">muzy@quasar.ia.br</a></li>
        <li><a href="https://www.linkedin.com/company/quasar-ia/" rel="noopener">LinkedIn</a></li>
        <li><a href="https://www.instagram.com/quasar.ia.br/" rel="noopener">Instagram</a></li>
        <li><a href="https://chat.whatsapp.com/HCzXAB70XIqBTvUaakYoxt" rel="noopener">Grupo de WhatsApp</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap foot-legal">
    <p>© 2026 QUASAR Technology. Dados de mercado e regulatórios com fonte indicada em cada seção.</p>
  </div>
</footer>

<style>
  .wrap { margin-inline: var(--gutter); }
  .sec { padding-block: clamp(5rem, 8vw, 9rem); }
  .dark { background: var(--navy-900); color: var(--text); }
  .light { background: var(--paper); color: var(--ink); }
  .paper { background: var(--paper-raised); color: var(--ink); }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  h3 { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.015em; }
  .lead { margin: 0; font-size: clamp(1.05rem, 1.2vw, 1.3rem); line-height: 1.55; max-width: 46ch; text-wrap: pretty; }
  .dark .lead, .leader .lead { color: var(--text-soft); }
  .light .lead, .paper .lead { color: var(--ink-soft); }
  .head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 1.5rem 6vw; align-items: end; margin-bottom: clamp(2.5rem, 4.5vw, 4.5rem); }

  /* Contexto */
  .context { background: radial-gradient(60% 80% at 85% 20%, rgb(11 143 214 / 0.16), transparent 70%), var(--navy-900); }
  .ctx-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr); gap: 3rem 6vw; align-items: start; }
  .ctx-grid .lead { margin-top: 1.5rem; }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem 3vw; }
  .stats li { border-top: 1px solid var(--line-strong); padding-top: 1.5rem; }
  .stat-fig { display: block; font-family: var(--font-display); font-size: clamp(2rem, 2.9vw, 3.6rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1; color: var(--blue-bright); }
  .stat-unit { display: block; margin-top: 0.35rem; font-size: 0.42em; font-weight: 600; letter-spacing: -0.01em; }
  .stats p { margin: 1rem 0 0.9rem; font-size: 1.0625rem; line-height: 1.5; color: var(--text); }
  .src { font-size: 0.8125rem; color: var(--text-muted); }

  /* Pilares */
  .pillar-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 1.6vw, 1.75rem); }
  .pcard { position: relative; aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden; background: var(--navy-800); color: #fff; scroll-margin-top: 2rem; }
  .pcard img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .pcard::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(7 12 24 / 0.15) 0%, rgb(7 12 24 / 0.55) 30%, rgb(7 12 24 / 0.9) 50%, rgb(7 12 24 / 0.98) 100%); }
  .pcard:hover img { transform: scale(1.05); }
  .pcard-body { position: absolute; inset: auto 0 0 0; z-index: 1; padding: clamp(1.4rem, 2vw, 2.2rem); }
  .pcard h3 { margin-top: 0; font-size: clamp(1.35rem, 1.8vw, 1.9rem); line-height: 1.1; }
  .pcard-body > p { margin: 0.75rem 0 0; font-size: 1rem; line-height: 1.5; color: rgb(255 255 255 / 0.82); }
  .pcard-offers { list-style: none; margin: 1rem 0 0; padding: 1rem 0 0; border-top: 1px solid rgb(255 255 255 / 0.18); display: grid; gap: 0.45rem; }
  .pcard-offers li { font-size: 0.9375rem; line-height: 1.4; color: rgb(255 255 255 / 0.9); padding-left: 1rem; position: relative; }
  .pcard-offers li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 0.45rem; height: 2px; background: var(--blue-bright); }

  /* Agenda */
  .horizon { position: relative; height: 8.5rem; margin: 0 1.5rem 3rem 0; }
  .horizon::before { content: ''; position: absolute; left: 0; right: 0; top: 4.6rem; height: 1px; background: linear-gradient(90deg, rgb(255 255 255 / 0.6) 0 18.5%, var(--blue) 18.5% 100%); }
  .h-today { position: absolute; top: 0; bottom: 3.2rem; width: 2px; margin-left: -1px; background: var(--blue-bright); }
  .h-today span { position: absolute; right: 0.5rem; top: 0; font-size: 0.8125rem; color: var(--blue-bright); letter-spacing: 0.04em; }
  .h-dot { position: absolute; top: calc(4.6rem - 0.45rem - var(--lane) * 1.6rem); width: 0.9rem; height: 0.9rem; margin-left: -0.45rem; border-radius: 50%; text-decoration: none; }
  .h-dot span { position: absolute; left: 50%; bottom: 1.2rem; transform: translateX(-50%); font-size: 0.8125rem; color: var(--text-soft); white-space: nowrap; }
  .h-dot.lane-up span { left: 1.2rem; bottom: auto; top: 50%; transform: translateY(-50%); }
  .h-dot.label-left span { left: auto; right: 1.2rem; }
  .h-dot.is-live { background: #fff; }
  .h-dot.is-pending { background: var(--navy-900); border: 2px solid var(--blue-bright); }
  .h-dot.is-ahead { background: var(--blue); }
  .h-axis span { position: absolute; top: 5.6rem; transform: translateX(-50%); font-size: 0.8125rem; color: var(--text-muted); }
  .h-axis span:first-child { transform: none; }
  .h-axis span:last-child { transform: translateX(-100%); }
  .table-scroll { overflow-x: auto; }
  .agenda { width: 100%; border-collapse: collapse; font-size: 1rem; }
  .agenda th, .agenda td { text-align: left; vertical-align: top; padding: 1.15rem 1.5rem 1.15rem 0; border-top: 1px solid var(--line); }
  .agenda thead th { font-size: 0.8125rem; font-weight: 500; color: var(--text-muted); border-top: 0; padding-bottom: 0.9rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .agenda tbody tr { scroll-margin-top: 2rem; transition: background-color 0.35s var(--ease-out); }
  .agenda tbody tr:hover, .agenda tbody tr:target { background: rgb(11 143 214 / 0.1); }
  .agenda tbody tr:last-child > * { border-bottom: 1px solid var(--line); }
  .when { white-space: nowrap; color: var(--text-soft); width: 7rem; }
  .item { font-weight: 500; width: 26%; }
  .item a { text-decoration: none; }
  .item a:hover { color: var(--blue-bright); }
  .ref { display: block; margin-top: 0.25rem; font-size: 0.8125rem; font-weight: 400; color: var(--text-muted); }
  .detail { color: var(--text-soft); line-height: 1.5; }
  .src-cell { width: 14%; font-size: 0.875rem; color: var(--text-muted); }
  .status { display: inline-flex; align-items: center; gap: 0.5rem; white-space: nowrap; font-size: 0.875rem; }
  .status::before { content: ''; width: 0.6rem; height: 0.6rem; border-radius: 50%; flex: none; }
  .is-live::before { background: #fff; }
  .is-pending::before { border: 2px solid var(--blue-bright); }
  .is-ahead::before { background: var(--blue); }
  .note { margin: 1.25rem 0 0; font-size: 0.8125rem; color: var(--text-muted); }

  /* Abordagem */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3vw; position: relative; }
  .steps::before { content: ''; position: absolute; left: 0; right: 0; top: 0.5rem; height: 1px; background: linear-gradient(90deg, var(--blue) 0 25%, var(--rule) 25% 100%); }
  .steps li { position: relative; padding-top: 2.75rem; }
  .step-marker { position: absolute; left: 0; top: 0; width: 1rem; height: 1rem; border-radius: 50%; background: var(--paper); border: 2px solid var(--blue); }
  .steps li:first-child .step-marker { background: var(--blue); }
  .step-num { display: block; font-family: var(--font-display); font-size: 2.25rem; font-weight: 700; color: var(--blue); line-height: 1; }
  .steps h3 { margin-top: 1.25rem; font-size: clamp(1.3rem, 1.6vw, 1.6rem); color: var(--ink); }
  .steps p { margin: 0.75rem 0 0; font-size: 1rem; line-height: 1.6; color: var(--ink-soft); }

  /* Perspectivas */
  .insights { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.25rem, 2vw, 2.25rem); }
  .icard a { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); height: 100%; }
  .icard-img { display: block; aspect-ratio: 3 / 2; overflow: hidden; border-radius: 12px; background: var(--navy-800); }
  .icard-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .icard a:hover .icard-img img { transform: scale(1.05); }
  .icard h3 { margin-top: 1.25rem; font-size: clamp(1.35rem, 1.7vw, 1.75rem); line-height: 1.15; }
  .icard p { margin: 0.75rem 0 0; font-size: 1rem; line-height: 1.6; color: var(--ink-soft); }
  .icard-more { margin-top: auto; padding-top: 1.25rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500; color: var(--blue); }
  .icard-more :global(svg) { width: 1rem; height: 1rem; transition: transform 0.35s var(--ease-out); }
  .icard a:hover .icard-more :global(svg) { transform: translateX(4px); }

  /* Setores */
  .sector-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr); gap: 3rem 6vw; align-items: start; }
  .sector-grid .lead { margin-top: 1.5rem; }
  .sectors { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .sectors li { border: 1px solid var(--line-strong); border-radius: 12px; padding: 1.75rem 2rem; transition: border-color 0.35s var(--ease-out), background-color 0.35s var(--ease-out); }
  .sectors li:hover { border-color: var(--blue); background: rgb(11 143 214 / 0.06); }
  .sectors h3 { font-size: clamp(1.3rem, 1.6vw, 1.6rem); }
  .sectors p { margin: 0.6rem 0 0; font-size: 1rem; line-height: 1.55; color: var(--text-soft); }

  /* Liderança */
  .leader { background: linear-gradient(110deg, var(--navy-950) 0%, var(--navy-850) 55%, #0d2a4a 100%); color: var(--text); padding-bottom: 0; }
  .leader-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 3rem 5vw; align-items: end; }
  .leader-copy { padding-bottom: clamp(5rem, 8vw, 9rem); }
  .role { margin: 0.75rem 0 2rem; font-size: 1.125rem; color: var(--blue-bright); }
  .leader-copy > p:not(.role) { margin: 0 0 1.1rem; font-size: 1.0625rem; line-height: 1.65; color: var(--text-soft); max-width: 60ch; }
