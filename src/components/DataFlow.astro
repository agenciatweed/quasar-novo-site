---
// Fluxo de dados (guia, seção 1.1 e 6): trilha curva de pacotes do ciano ao roxo,
// nós de circuito, cadeado (proteção) e escudo com check (verificação).
// Sempre em espaço livre, nunca sobre o texto.
interface Props { class?: string; flip?: boolean }
const { class: cls = '', flip = false } = Astro.props;
const uid = 'fl' + Math.random().toString(36).slice(2, 8);
const d = 'M-30 330 C 380 200 720 300 1230 160';
---
<svg class:list={['dataflow', cls, { flip }]} viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={uid} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#35C6F0" stop-opacity="0" />
      <stop offset=".25" stop-color="#35C6F0" />
      <stop offset=".75" stop-color="#8C6EFF" />
      <stop offset="1" stop-color="#8C6EFF" stop-opacity="0" />
    </linearGradient>
  </defs>
  <path d={d} fill="none" stroke={`url(#${uid})`} stroke-width="1" opacity=".5" />
  <path class="pk" d={d} fill="none" stroke={`url(#${uid})`} stroke-width="4" stroke-linecap="round" stroke-dasharray="2 16" />
  <path class="burst" d={d} fill="none" stroke={`url(#${uid})`} stroke-width="3" stroke-linecap="round" stroke-dasharray="34 120 10 90 60 160" />
  {[[150.5, 285.4], [562.5, 248.8], [1053.3, 200.8]].map(([x, y], i) => (
    <g class="node" style={`--i:${i}`}>
      <circle cx={x} cy={y} r="9" fill="none" stroke="#35C6F0" stroke-opacity=".6" stroke-width="1.5" />
      <circle cx={x} cy={y} r="3.5" fill="#35C6F0" />
    </g>
  ))}
  <g transform="translate(326.6 262.4)">
    <rect x="-28" y="-28" width="56" height="56" rx="16" fill="#0A141C" stroke={`url(#${uid})`} stroke-width="2" />
    <path d="M-8 -2 V-8 a8 8 0 0 1 16 0 V-2" fill="none" stroke="#35C6F0" stroke-width="2.4" stroke-linecap="round" />
    <rect x="-11" y="-2" width="22" height="16" rx="3" fill="none" stroke="#35C6F0" stroke-width="2.4" />
    <circle cx="0" cy="6" r="2" fill="#35C6F0" />
  </g>
  <g transform="translate(810.4 233.9)">
    <rect x="-28" y="-28" width="56" height="56" rx="16" fill="#0A141C" stroke={`url(#${uid})`} stroke-width="2" />
    <path d="M0 -13 L11 -8 V0 C11 7 6 11 0 13 C-6 11 -11 7 -11 0 V-8 Z" fill="none" stroke="#9B86FF" stroke-width="2.4" stroke-linejoin="round" />
    <path d="M-4.5 0 L-1 3.5 L5 -3" fill="none" stroke="#9B86FF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </g>
</svg>
<style>
  .dataflow { position: absolute; pointer-events: none; z-index: 0; overflow: visible; }
  .dataflow.flip { transform: scaleX(-1); }
  .dataflow.flip :global(g[transform]) { transform-box: fill-box; }
  .pk { animation: pk 1.4s linear infinite; }
  .burst { animation: burst 7s linear infinite; }
  .node circle:first-child { transform-box: fill-box; transform-origin: center; animation: node 2.8s var(--ease) infinite; animation-delay: calc(var(--i) * 0.6s); }
  @keyframes pk { to { stroke-dashoffset: -18; } }
  @keyframes burst { to { stroke-dashoffset: -474; } }
  @keyframes node { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.7); opacity: 0.2; } }
  @media (prefers-reduced-motion: reduce) { .pk, .burst, .node circle { animation: none !important; } }
</style>
