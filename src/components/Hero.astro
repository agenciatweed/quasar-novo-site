---
import { Image } from 'astro:assets';
const splitLast = (t: string) => { const w = t.split(' '); const last = w.pop(); return [w.join(' '), last]; };
import heroPlate from '../../assets/plates/hero-photo.png';
import { featured } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <Image class="hero-photo" src={heroPlate} alt="" widths={[1100, 1600, 2400, 3200]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={80} />
  <div class="hero-copy" id="conteudo">
    <h1 id="hero-title"><span class="line">Antecipamos o <span class="accent">futuro</span>.</span> <span class="line">Protegemos o que importa.</span></h1>
    <p class="sub">Consultoria estratégica em risco tecnológico, IA, computação quântica e segurança pós-quântica para Conselhos e executivos.</p>
    <div class="ctas">
      <a class="pill pill-solid cta" href="#contato">Fale com a QUASAR</a>
      <a class="pill pill-ghost cta" href="#pilares">Conheça os pilares</a>
    </div>
  </div>
  <ul class="featured" aria-label="Em destaque">
    {featured.map((f) => (
      <li>
        <a href={f.href}>
          <span class="f-title">{splitLast(f.title)[0]} <span class="keep">{splitLast(f.title)[1]}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></span></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    position: relative;
    height: 46.15vw;
    background: var(--navy-900);
    overflow: hidden;
  }
  .hero-photo {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 38.88vw;
    object-fit: cover;
    object-position: 60% 40%;
    animation: hero-in 1.6s var(--ease-out) both;
  }
  .hero::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 38.88vw;
    background: linear-gradient(90deg, #0b101d 0 8.3%, rgb(11 16 29 / 0.9) 15%, rgb(11 16 29 / 0.55) 34%, transparent 60%);
    z-index: 0;
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 33vw;
    height: 6vw;
    background: linear-gradient(transparent, var(--navy-900));
    pointer-events: none;
  }
  .hero-copy { position: absolute; left: 8.07vw; top: 7.41vw; width: 56vw; z-index: 1; }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 4.58vw;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }
  h1 .line { display: block; white-space: nowrap; }
  .accent { color: var(--blue-bright); text-shadow: 0 0 1.4vw rgb(63 180 255 / 0.35); }
  .sub {
    margin: 1.55vw 0 0;
    width: 44.5vw;
    font-size: 1.45vw;
    line-height: 1.36;
    color: var(--text-soft);
  }
  .ctas { display: flex; gap: 1.05vw; margin-top: 2.2vw; }
  .cta { height: 3.5vw; padding-inline: 0; font-size: 1.3vw; }
  .cta.pill-solid { width: 15.7vw; }
  .cta.pill-ghost { width: 15.05vw; }

  .featured {
    position: absolute;
    left: 8.21vw;
    top: 33.72vw;
    width: 83.58vw;
    height: 10.32vw;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: rgb(22 34 59 / 0.82);
    backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    border-radius: 0.7vw;
    z-index: 2;
  }
  .featured li { display: flex; align-items: flex-start; padding: 1.75vw 2.7vw; }
  .featured li + li { border-left: 1px solid var(--line-strong); margin-block: 1.2vw; padding-block: 0.55vw; }
  .featured a { display: block; text-decoration: none; }
  .keep { white-space: nowrap; }
  .f-title { max-width: 24vw; font-size: 1.75vw; font-weight: 500; line-height: 1.2; color: #fff; }
  .f-title svg { display: inline-block; width: 1.3vw; height: 1.3vw; margin-left: 0.5vw; vertical-align: -0.1em; transition: transform 0.35s var(--ease-out); }
  .featured a:hover .f-title svg { transform: translateX(0.35vw); }
  .featured a:hover .f-title { color: var(--blue-bright); }

  @keyframes hero-in { from { opacity: 0; transform: scale(1.04); } to { opacity: 1; transform: none; } }

  @media (max-width: 1100px) {
    .hero { height: auto; padding: 0 1.25rem 2.5rem; }
    .hero-photo { height: 100%; max-height: 40rem; object-position: 72% 30%; opacity: 0.6; }
    .hero::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 38.88vw;
    background: linear-gradient(90deg, #0b101d 0 8.3%, rgb(11 16 29 / 0.9) 15%, rgb(11 16 29 / 0.55) 34%, transparent 60%);
    z-index: 0;
    pointer-events: none;
  }
  .hero::after { top: auto; bottom: 0; height: 60%; }
    .hero-copy { position: relative; left: 0; top: 0; width: auto; padding-top: 5rem; }
    h1 { font-size: clamp(2.3rem, 8.5vw, 3.6rem); }
    h1 .line { display: inline; white-space: normal; }
    .sub { width: auto; font-size: 1.0625rem; margin-top: 1.25rem; max-width: 36rem; }
    .ctas { flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
    .cta, .cta.pill-solid, .cta.pill-ghost { width: auto; height: 3rem; padding-inline: 1.4rem; font-size: 1rem; }
    .featured { position: relative; left: 0; top: 0; width: auto; height: auto; margin-top: 3rem; grid-template-columns: 1fr; border-radius: 12px; }
    .featured li { padding: 1.25rem 1.25rem; }
    .featured li + li { border-left: 0; border-top: 1px solid var(--line); margin: 0; padding-block: 1.25rem; }
    .featured a { gap: 0.4rem; }
      .f-title { max-width: none; font-size: 1.125rem; }
    .f-title svg { width: 1rem; height: 1rem; margin-left: 0.35rem; }
  }
</style>
