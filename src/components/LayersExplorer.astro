---
// Mapa de Controles em 6 Camadas — explorador interativo (abas acessíveis).
import Icon from './Icon.astro';
import { layers, services, serviceHref } from '../data/site';
interface Props { id?: string }
const { id = 'camadas' } = Astro.props;
---
<div class="lx" data-lx id={id}>
  <div class="lx-tabs" role="tablist" aria-label="Camadas do modelo Quasar" aria-orientation="vertical">
    {layers.map((l, i) => (
      <button type="button" role="tab" class="lx-tab" id={`${id}-tab-${l.id}`} aria-controls={`${id}-panel-${l.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="lx-num mono">{l.num}</span>
        <span class="lx-txt"><strong>{l.title}</strong><small>{l.subtitle}</small></span>
        <Icon name="chevron-right" size={18} class="lx-arrow" />
      </button>
    ))}
  </div>
  <div class="lx-panels">
    {layers.map((l, i) => {
      const rel = services.filter((s) => s.layers.includes(l.id));
      return (
        <div class="lx-panel card hud" role="tabpanel" id={`${id}-panel-${l.id}`} aria-labelledby={`${id}-tab-${l.id}`} hidden={i !== 0} style="--hud-size:18px; --hud-alpha:.6">
          <div class="lx-head">
            <span class="ico" style="--ico:56px"><Icon name={l.icon} /></span>
            <div>
              <p class="lx-kicker">Camada {l.num} de 06</p>
              <h3 class="h3">{l.title}</h3>
            </div>
            <div class="lx-meter" aria-hidden="true">{layers.map((m) => <span class:list={{ on: m.id <= l.id }} />)}</div>
          </div>
          <div class="lx-boxes">
            <div class="lx-box"><p class="lx-label"><Icon name="shield-check" size={16} />O que esta camada protege</p><p>{l.protects}</p></div>
            <div class="lx-box"><p class="lx-label lx-label--v"><Icon name="shield-alert" size={16} />Risco corporativo mitigado</p><p>{l.risk}</p></div>
          </div>
          <p class="lx-label lx-label--plain">Controles integrados na camada</p>
          <ul class="lx-controls">{l.controls.map((c) => <li><Icon name="check" size={16} />{c}</li>)}</ul>
          {rel.length > 0 && (
            <div class="lx-rel">
              <span>Frentes relacionadas</span>
              {rel.map((s) => <a href={serviceHref(s)} class="chip">{s.menu}<Icon name="arrow-up-right" size={13} /></a>)}
            </div>
          )}
        </div>
      );
    })}
  </div>
</div>
<style>
  .lx { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(20px, 2.4vw, 36px); align-items: start; }
  .lx-tabs { display: grid; gap: 8px; }
  .lx-tab { position: relative; width: 100%; display: flex; align-items: center; gap: 16px; text-align: left; padding: 16px 18px; border-radius: 14px; border: 1px solid var(--line); background: rgb(10 20 28 / 0.6); transition: border-color 0.3s, background-color 0.3s; }
  .lx-tab:hover { border-color: var(--line-2); background: rgb(14 27 37 / 0.9); }
  .lx-tab[aria-selected='true'] { border-color: rgb(53 198 240 / 0.55); background: linear-gradient(90deg, rgb(0 163 214 / 0.16), rgb(124 92 255 / 0.06)); box-shadow: 0 20px 40px -28px rgb(0 163 214 / 0.8); }
  .lx-num { flex: none; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 10px; border: 1px solid var(--line-2); color: var(--cyan-hi); font-size: 0.8rem; letter-spacing: 0.05em; }
  .lx-tab[aria-selected='true'] .lx-num { background: var(--cyan); color: var(--bg); border-color: var(--cyan); font-weight: 700; }
  .lx-txt { min-width: 0; flex: 1; }
  .lx-txt strong { display: block; color: #fff; font-weight: 600; font-size: 0.98rem; line-height: 1.3; }
  .lx-txt small { display: block; margin-top: 3px; color: var(--text-4); font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lx-tab :global(.lx-arrow) { color: var(--text-4); transition: transform 0.35s var(--ease), color 0.3s; flex: none; }
  .lx-tab[aria-selected='true'] :global(.lx-arrow) { color: var(--cyan-hi); transform: translateX(3px); }
  .lx-panels { position: sticky; top: calc(var(--header-h) + 24px); }
  .lx-panel { padding: clamp(26px, 3vw, 40px); }
  .lx-panel:not([hidden]) { animation: lxin 0.5s var(--ease); }
  @keyframes lxin { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .lx-head { display: flex; align-items: center; gap: 18px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .lx-head > div:nth-child(2) { flex: 1; }
  .lx-kicker { font-size: 0.85rem; color: var(--cyan-hi); font-weight: 600; margin-bottom: 6px; }
  .lx-meter { display: flex; gap: 4px; align-self: flex-start; }
  .lx-meter span { width: 6px; height: 22px; border-radius: 3px; background: var(--line); }
  .lx-meter span.on { background: linear-gradient(180deg, var(--cyan-hi), var(--violet-2)); }
  .lx-boxes { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 24px 0; }
  .lx-box { padding: 20px; border-radius: 12px; background: rgb(3 7 11 / 0.5); border: 1px solid var(--line); }
  .lx-box p:last-child { font-size: 0.95rem; color: var(--text-2); line-height: 1.6; }
  .lx-label { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 600; color: var(--cyan-hi); margin-bottom: 10px; }
  .lx-label--v { color: var(--lilac); }
  .lx-label--plain { color: var(--text-3); margin-bottom: 12px; }
  .lx-controls { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .lx-controls li { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--line); background: rgb(10 20 28 / 0.7); font-size: 0.92rem; color: var(--text); font-weight: 500; line-height: 1.35; }
  .lx-controls :global(svg) { color: var(--cyan-hi); flex: none; }
  .lx-rel { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 24px; padding-top: 22px; border-top: 1px solid var(--line); }
  .lx-rel > span { font-size: 0.85rem; color: var(--text-4); margin-right: 6px; }
  .lx-rel .chip { transition: border-color 0.2s, color 0.2s; }
  .lx-rel .chip:hover { border-color: var(--cyan-hi); color: var(--cyan-hi); }
  @media (max-width: 960px) {
    .lx { grid-template-columns: 1fr; }
    .lx-panels { position: static; }
    .lx-boxes, .lx-controls { grid-template-columns: 1fr; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-lx]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>('#' + x.getAttribute('aria-controls'))!.hidden = !on;
      });
      if (focus) t.focus();
      else if (window.matchMedia('(max-width: 960px)').matches) {
        root.querySelector('#' + t.getAttribute('aria-controls'))!.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowDown' || k === 'ArrowRight') { e.preventDefault(); select(tabs[(i + 1) % tabs.length], true); }
        if (k === 'ArrowUp' || k === 'ArrowLeft') { e.preventDefault(); select(tabs[(i - 1 + tabs.length) % tabs.length], true); }
        if (k === 'Home') { e.preventDefault(); select(tabs[0], true); }
        if (k === 'End') { e.preventDefault(); select(tabs[tabs.length - 1], true); }
      });
    });
  });
</script>
