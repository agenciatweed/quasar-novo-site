---
import { pillars, perspectives } from '../data/site';

const menus = [
  {
    label: 'Pilares',
    items: pillars.map((p) => ({ label: p.name, href: `#pilar-${p.num}`, note: p.ref })),
    wide: true,
  },
  {
    label: 'Setores',
    items: [
      { label: 'Instituições financeiras', href: '#setores' },
      { label: 'Infraestrutura crítica e ambientes regulados', href: '#setores' },
      { label: 'Médias e grandes empresas', href: '#setores' },
    ],
  },
  {
    label: 'Insights',
    items: [
      ...perspectives.map((p) => ({ label: p.title, href: '#perspectivas' })),
      { label: 'Agenda do Conselho', href: '#agenda' },
    ],
  },
  {
    label: 'Liderança',
    items: [
      { label: 'Jorge Muzy', href: '#lideranca' },
      { label: 'Ecossistema', href: '#ecossistema' },
    ],
  },
  {
    label: 'Sobre',
    items: [
      { label: 'Abordagem', href: '#abordagem' },
      { label: 'Por que agora', href: '#contexto' },
      { label: 'Contato', href: '#contato' },
    ],
  },
];
---
<header class="site-header">
  <div class="utility">
    <ul>
      <li><a href="#abordagem">Sobre a QUASAR</a></li>
      <li aria-hidden="true">·</li>
      <li><a href="#ecossistema">AI Summit Brasil 2026</a></li>
      <li aria-hidden="true">·</li>
      <li><a href="#contato">Contato</a></li>
    </ul>
  </div>
  <div class="bar">
    <a class="brand" href="/" aria-label="QUASAR — página inicial">
      <img src="/brand/quasar-mark.png" alt="" width="88" height="88" />
      <span>QUASAR</span>
    </a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="main-nav">
      <span class="sr-only">Abrir menu</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    <nav id="main-nav" class="nav" aria-label="Principal">
      <ul class="menu">
        {menus.map((m, i) => (
          <li class:list={['menu-item', { wide: m.wide }]}>
            <button type="button" class="menu-trigger" aria-expanded="false" aria-controls={`mega-${i}`}>
              {m.label}
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </button>
            <div class="mega" id={`mega-${i}`}>
              <ul>
                {m.items.map((it) => (
                  <li><a href={it.href}>{'note' in it && it.note ? <span class="mega-ref">{it.note}</span> : null}{it.label}</a></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
      <a class="pill pill-solid nav-cta" href="#contato">Fale com a QUASAR</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const triggers = header?.querySelectorAll<HTMLButtonElement>('.menu-trigger') ?? [];
  const closeAll = (except?: HTMLButtonElement) =>
    triggers.forEach((t) => t !== except && t.setAttribute('aria-expanded', 'false'));
  triggers.forEach((t) =>
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') === 'true';
      closeAll(t);
      t.setAttribute('aria-expanded', String(!open));
    }),
  );
  header?.querySelectorAll('.mega a').forEach((a) => a.addEventListener('click', () => closeAll()));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeAll());
  document.addEventListener('click', (e) => {
    if (!header?.contains(e.target as Node)) closeAll();
  });
  const burger = header?.querySelector<HTMLButtonElement>('.burger');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
  });
</script>

<style>
  .site-header { position: relative; z-index: 20; }
  .utility {
    height: 3.09vw;
    background: var(--navy-950);
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding-inline: var(--gutter) 6.4vw;
  }
  .utility ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.05vw; align-items: center; }
  .utility li, .utility a { font-size: 1.17vw; color: var(--text-muted); text-decoration: none; line-height: 1; }
  .utility a:hover { color: var(--text); }

  .bar {
    height: 6.58vw;
    display: flex;
    align-items: center;
    padding-left: 6.47vw;
    padding-right: 6.36vw;
    background: var(--navy-850);
    border-bottom: 1px solid var(--line);
  }
  .brand { display: inline-flex; align-items: center; gap: 1.0vw; text-decoration: none; }
  .brand img { width: 3.2vw; height: 3.2vw; }
  .brand span {
    font-family: var(--font-wordmark);
    font-size: 2.2vw;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
    line-height: 1;
  }
  .burger { display: none; }

  .nav { margin-left: auto; display: flex; align-items: center; gap: 1.9vw; }
  .menu { list-style: none; margin: 0; padding: 0; display: flex; gap: 2.05vw; }
  .menu-item { position: relative; }
  .menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45vw;
    background: none;
    border: 0;
    padding: 0.4vw 0;
    font: inherit;
    font-size: 1.42vw;
    color: var(--text);
    cursor: pointer;
  }
  .menu-trigger svg { width: 0.85vw; height: 0.85vw; transition: transform 0.3s var(--ease-out); }
  .menu-trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
  .menu-trigger:hover { color: var(--blue-bright); }

  .mega {
    position: absolute;
    top: calc(100% + 1.6vw);
    left: -1.2vw;
    min-width: 22rem;
    padding: 1.25rem 0.5rem;
    background: var(--navy-850);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out), visibility 0.25s;
  }
  .wide .mega { min-width: 36rem; }
  .wide .mega ul { grid-template-columns: 1fr 1fr; }
  .menu-trigger[aria-expanded='true'] + .mega { opacity: 1; visibility: visible; transform: none; }
  .mega ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .mega a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.7rem 1rem;
    border-radius: 8px;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--text);
    text-decoration: none;
  }
  .mega a:hover { background: var(--navy-800); color: var(--blue-bright); }
  .mega-ref { font-size: 0.8125rem; color: var(--text-muted); }

  .nav-cta { width: 14.4vw; height: 3.3vw; padding-inline: 0; font-size: 1.32vw; }

  @media (max-width: 1100px) {
    .utility { height: 2.25rem; padding-inline: 1.25rem; }
    .utility li, .utility a { font-size: 0.8125rem; }
    .utility ul { gap: 0.6rem; }
    .bar { height: 4.25rem; padding-inline: 1.25rem; position: relative; }
    .brand { gap: 0.6rem; }
    .brand img { width: 2.25rem; height: 2.25rem; }
    .brand span { font-size: 1.25rem; }
    .burger {
      display: inline-grid;
      place-items: center;
      margin-left: auto;
      width: 2.75rem;
      height: 2.75rem;
      background: none;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      color: var(--text);
    }
    .burger svg { width: 1.25rem; height: 1.25rem; }
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem 1.25rem 1.5rem;
      background: var(--navy-850);
      border-bottom: 1px solid var(--line);
      display: none;
    }
    .burger[aria-expanded='true'] + .nav { display: flex; }
    .menu { flex-direction: column; gap: 0; }
    .menu-trigger { width: 100%; justify-content: space-between; font-size: 1.0625rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); }
    .menu-trigger svg { width: 0.8rem; height: 0.8rem; }
    .mega, .wide .mega { position: static; min-width: 0; display: none; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; padding: 0.25rem 0 0.75rem; background: none; }
    .menu-trigger[aria-expanded='true'] + .mega { display: block; }
    .wide .mega ul { grid-template-columns: 1fr; }
    .nav-cta { width: auto; height: 3rem; padding-inline: 1.5rem; font-size: 1rem; align-self: flex-start; }
  }
</style>
