---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories, layers, services, servicesBy, serviceHref, type CatKey, type Service } from '../../data/site';
import { articlesIn } from '../../data/articles';

export function getStaticPaths() {
  return services.map((s) => ({ params: { cat: s.cat, slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const cat = categories[s.cat];
const related = articlesIn(s.related);
const cats: CatKey[] = ['consultoria', 'servicos-gerenciados'];
const sLayers = s.layers.map((n) => layers.find((l) => l.id === n)!);
const sameCat = servicesBy(s.cat);
const idx = sameCat.findIndex((x) => x.slug === s.slug);
const next = sameCat[(idx + 1) % sameCat.length];
---
<Base title={s.title} description={`${s.short} ${cat.title} da Quasar Technology.`}>
  <PageHero img={`svc-${s.slug}`} title={s.title} lead={s.short} crumbs={[{ href: `/${s.cat}/`, label: cat.short }, { label: s.menu }]} side={`// ${cat.short.toLowerCase()} · ${s.slug}`}>
    <a href="/diagnostico-executivo/" class="btn btn-primary">Agendar Diagnóstico Executivo<Icon name="arrow-right" /></a>
    <a href="/raio-x/" class="btn btn-ghost"><Icon name="scan-eye" />Fazer o Raio-X</a>
    <div slot="after" class="svc-tags">
      <span class="chip"><Icon name={s.icon} />{s.tag}</span>
      <span class="chip"><Icon name={cat.icon} />{cat.title}</span>
    </div>
  </PageHero>

  <section class="section svc">
    <div class="fx-grid" style="--gx:90%; --gy:5%"></div>
    <div class="wrap svc-grid">
      <aside class="svc-side" aria-label="Todas as frentes">
        <div class="side-box">
          {cats.map((c) => (
            <div class="side-group">
              <p class="side-t"><Icon name={categories[c].icon} size={16} />{categories[c].title}</p>
              <ul>
                {servicesBy(c).map((x) => (
                  <li><a href={serviceHref(x)} class:list={{ on: x.slug === s.slug }} aria-current={x.slug === s.slug ? 'page' : undefined}>{x.menu}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <a href="/diagnostico-executivo/" class="side-cta hud" style="--hud-size:12px">
          <Icon name="target" size={20} />
          <span><strong>Diagnóstico Executivo</strong><small>60 min · 6 camadas · 3 prioridades</small></span>
        </a>
      </aside>

      <div class="svc-main">
        <article class="blk" data-reveal>
          <h2 class="blk-t"><span class="blk-n mono">01</span>O impacto no negócio</h2>
          <div class="impact card hud" style="--hud-size:16px; --hud-alpha:.55">
            <span class="ico ico--violet" style="--ico:52px"><Icon name="triangle-alert" /></span>
            <p>{s.impact}</p>
          </div>
        </article>

        <article class="blk" data-reveal>
          <h2 class="blk-t"><span class="blk-n mono">02</span>Como a Quasar atua</h2>
          <ol class="steps">
            {s.methodology.map((m, i) => (
              <li><span class="step-dot mono">{String(i + 1).padStart(2, '0')}</span><p>{m}</p></li>
            ))}
          </ol>
        </article>

        <article class="blk" data-reveal>
          <h2 class="blk-t"><span class="blk-n mono">03</span>Capacidades técnicas envolvidas</h2>
          <ul class="caps">{s.capabilities.map((c) => <li><Icon name="check" size={16} />{c}</li>)}</ul>
          <p class="caps-note"><Icon name="info" size={15} />Independente de fabricante: as tecnologias são escolhidas pelo risco e pelo ambiente de cada empresa.</p>
        </article>

        <article class="blk" data-reveal>
          <h2 class="blk-t"><span class="blk-n mono">04</span>Perguntas que esta frente responde ao conselho</h2>
          <ul class="qs">
            {s.boardQuestions.map((q) => <li class="card"><Icon name="circle-help" size={22} /><p>{q}</p></li>)}
          </ul>
        </article>

        <article class="blk" data-reveal>
          <h2 class="blk-t"><span class="blk-n mono">05</span>Onde atua no modelo de 6 camadas</h2>
          <div class="lyr">
            <div class="lyr-stack" aria-hidden="true">
              {layers.map((l) => <span class:list={{ on: s.layers.includes(l.id) }}><b class="mono">{l.num}</b></span>)}
            </div>
            <ul class="lyr-list">
              {sLayers.map((l) => (
                <li><a href={`/metodologia/#camada-${l.num}`} class="card"><span class="ico" style="--ico:44px"><Icon name={l.icon} /></span><span><strong>Camada {l.num} · {l.title}</strong><small>{l.subtitle}</small></span><Icon name="arrow-up-right" size={16} /></a></li>
              ))}
            </ul>
          </div>
        </article>

        <a href={serviceHref(next)} class="next card" data-reveal>
          <span><small>Próxima frente de {cat.short}</small><strong>{next.title}</strong></span>
          <Icon name="arrow-right" size={22} />
        </a>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--tint section--line">
      <div class="wrap">
        <div class="rel-head" data-reveal>
          <h2 class="h2">Leituras para <span class="grad">a diretoria.</span></h2>
          <a href="/insights/" class="btn btn-ghost">Todos os insights<Icon name="arrow-right" /></a>
        </div>
        <div class="rel-grid">{related.map((a, i) => <ArticleCard a={a} delay={i * 0.08} />)}</div>
      </div>
    </section>
  )}

  <CtaBand variant="diagnostico" title="Deseja avaliar esta frente na sua empresa?" />
</Base>

<style>
  .svc-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
  .svc-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .svc-side { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 14px; }
  .side-box { padding: 10px; border-radius: var(--radius); border: 1px solid var(--line); background: rgb(10 20 28 / 0.6); }
  .side-group + .side-group { margin-top: 6px; padding-top: 10px; border-top: 1px solid var(--line); }
  .side-t { display: flex; align-items: center; gap: 8px; padding: 10px 12px 8px; font-size: 0.78rem; font-weight: 700; color: var(--cyan-hi); }
  .side-group ul { list-style: none; display: grid; gap: 2px; }
  .side-group a { display: block; padding: 9px 12px; border-radius: 10px; font-size: 0.88rem; color: var(--text-3); line-height: 1.35; transition: background-color 0.2s, color 0.2s; }
  .side-group a:hover { color: #fff; background: rgb(255 255 255 / 0.04); }
  .side-group a.on { color: var(--bg); background: var(--cyan); font-weight: 600; }
  .side-cta { display: flex; align-items: center; gap: 14px; padding: 18px; border-radius: var(--radius); border: 1px solid var(--line-2); background: linear-gradient(135deg, rgb(0 163 214 / 0.14), rgb(124 92 255 / 0.1)); color: var(--cyan-hi); }
  .side-cta strong { display: block; color: #fff; font-size: 0.95rem; }
  .side-cta small { display: block; color: var(--text-4); font-size: 0.8rem; }
  .svc-main { display: grid; gap: clamp(56px, 6vw, 84px); min-width: 0; }
  .blk-t { display: flex; align-items: center; gap: 14px; font-size: clamp(1.45rem, 2vw, 1.9rem); letter-spacing: -0.03em; margin-bottom: 26px; }
  .blk-n { flex: none; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 10px; border: 1px solid var(--line-2); color: var(--cyan-hi); font-size: 0.72rem; letter-spacing: 0.04em; }
  .impact { display: flex; gap: 22px; align-items: flex-start; padding: clamp(24px, 3vw, 38px); background: linear-gradient(135deg, rgb(124 92 255 / 0.1), rgb(10 20 28 / 0.95) 55%); }
  .impact p { font-size: clamp(1.1rem, 1.35vw, 1.3rem); line-height: 1.6; color: var(--text); }
  .steps { list-style: none; position: relative; display: grid; gap: 14px; }
  .steps::before { content: ''; position: absolute; left: 21px; top: 24px; bottom: 24px; width: 1px; background: linear-gradient(180deg, var(--cyan-hi), var(--violet-2)); opacity: 0.5; }
  .steps li { position: relative; display: flex; gap: 22px; align-items: flex-start; padding: 20px 24px 20px 0; }
  .step-dot { position: relative; flex: none; width: 43px; height: 43px; display: grid; place-items: center; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--cyan-hi); color: var(--cyan-hi); font-size: 0.72rem; letter-spacing: 0.02em; box-shadow: 0 0 0 6px var(--bg); }
  .steps p { padding-top: 9px; color: var(--text-2); font-size: 1.05rem; }
  .caps { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .caps li { display: inline-flex; align-items: center; gap: 9px; padding: 11px 16px; border-radius: 12px; border: 1px solid var(--line-2); background: rgb(10 20 28 / 0.7); font-weight: 500; color: #fff; font-size: 0.95rem; }
  .caps :global(svg) { color: var(--cyan-hi); }
  .caps-note { display: flex; align-items: center; gap: 8px; margin-top: 18px; font-size: 0.85rem; color: var(--text-4); }
  .qs { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .qs li { display: flex; flex-direction: column; gap: 16px; padding: 24px; }
  .qs :global(svg) { color: var(--lilac); }
  .qs p { color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 1.08rem; line-height: 1.35; letter-spacing: -0.015em; }
  .lyr { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 24px; align-items: start; }
  .lyr-stack { display: grid; gap: 6px; }
  .lyr-stack span { display: flex; align-items: center; justify-content: center; height: 30px; border-radius: 8px; border: 1px solid var(--line); background: rgb(10 20 28 / 0.6); color: var(--text-4); transform: perspective(300px) rotateX(18deg); }
  .lyr-stack span.on { border-color: var(--cyan-hi); background: linear-gradient(90deg, rgb(0 163 214 / 0.35), rgb(124 92 255 / 0.25)); color: #fff; box-shadow: 0 0 24px -4px rgb(53 198 240 / 0.6); }
  .lyr-stack b { font-size: 0.68rem; font-weight: 600; }
  .lyr-list { list-style: none; display: grid; gap: 10px; }
  .lyr-list a { display: flex; align-items: center; gap: 16px; padding: 16px 20px; }
  .lyr-list a > span:nth-child(2) { flex: 1; }
  .lyr-list strong { display: block; color: #fff; font-weight: 600; }
  .lyr-list small { display: block; color: var(--text-4); font-size: 0.85rem; }
  .lyr-list a > :global(svg:last-child) { color: var(--cyan-hi); }
  .next { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 26px 30px; }
  .next small { display: block; color: var(--text-4); font-size: 0.85rem; }
  .next strong { display: block; color: #fff; font-family: var(--font-display); font-size: 1.3rem; letter-spacing: -0.02em; margin-top: 4px; }
  .next > :global(svg) { color: var(--cyan-hi); transition: transform 0.35s var(--ease); flex: none; }
  .next:hover > :global(svg) { transform: translateX(5px); }
  .rel-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 44px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 1100px) { .svc-grid { grid-template-columns: 1fr; } .svc-side { position: static; order: 2; } .qs, .rel-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 680px) { .qs, .rel-grid { grid-template-columns: 1fr; } .lyr { grid-template-columns: 1fr; } .lyr-stack { grid-template-columns: repeat(6, 1fr); } .lyr-stack span { transform: none; } }
</style>
